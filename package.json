{
  "name": "@ownference/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A browser SDK and demo for bringing your own local AI models.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "bin": {
    "ownference-web": "./bin/ownference-web.js"
  },
  "files": [
    "src",
    "bin",
    "public",
    "server.js",
    "docs/assets",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=70",
    "typecheck": "tsc -p tsconfig.json",
    "secrets": "secretlint '**/*'",
    "check": "npm run lint && npm run secrets && npm run typecheck && npm test",
    "smoke": "node smoke.js"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "eslint": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "secretlint": "13.1.0",
    "typescript": "7.0.2"
  }
}
